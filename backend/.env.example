FLASK_ENV=production
SECRET_KEY=change-this-to-a-secure-random-secret-key-12345
JWT_SECRET_KEY=change-this-to-a-secure-jwt-secret-key-67890
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Supabase PostgreSQL database URL (format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres)
# If left empty, SQLite (campuscare.db) will be used locally for development
DATABASE_URL=

# Supabase Storage configuration (optional for local development, required for production)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=complaint-images

# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# Upload limit in bytes (5MB)
MAX_CONTENT_LENGTH=5242880
